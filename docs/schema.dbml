// Logical schema for TNDC Jewelry House.
// Decisions D1–D5. Milestone 1 turns this into Alembic migrations.
// Ukraine is the primary market (UAH, uk). Poland is the second (PLN, pl).

Project tndc_jewelry_house {
  database_type: 'PostgreSQL'
  Note: '''
    FastAPI is the only database client. Embeddings are multilingual-e5-small, 384 dimensions.
    Postgres mapping for Alembic (see Milestone 1):
    every timestamp column is timestamptz;
    users.email is a partial unique index WHERE deleted_at IS NULL, not a column UNIQUE;
    child catalog/cart rows ON DELETE CASCADE, orders/order_items/payments ON DELETE RESTRICT.
  '''
}

TableGroup auth {
  users
  user_profiles
  refresh_tokens
}

TableGroup markets {
  markets
  exchange_rates
  shipping_methods
  user_addresses
}

TableGroup catalog {
  categories
  category_translations
  products
  product_translations
  product_variants
  variant_prices
  price_history
  product_images
  gemstones
  product_gemstones
  product_embeddings
}

TableGroup commerce {
  carts
  cart_items
  orders
  order_items
  payments
  favorites
}

Table users {
  id bigint [pk, increment]
  email varchar(255) [not null, note: 'unique where deleted_at is null']
  role Role [not null, default: 'User']
  status UserStatus [not null, default: 'PendingVerification']
  password_hash varchar(255) [not null, note: 'argon2id or bcrypt, never plaintext']
  failed_login_attempts integer [not null, default: 0]
  locked_until timestamp [null]
  email_verified_at timestamp [null]
  last_login_at timestamp [null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp [null]
}

Table user_profiles {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  first_name varchar(100) [null]
  last_name varchar(100) [null]
  phone_number varchar(32) [null]
  date_of_birth date [null, note: 'enables birthday offers']
  preferred_language varchar(10) [not null, default: 'uk']
  preferred_market_id integer [null, ref: > markets.id]
  consent_personal_data boolean [not null, default: false]
  consent_marketing boolean [not null, default: false]
  consent_updated_at timestamp [null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table refresh_tokens {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  token_hash varchar(255) [not null]
  device_info varchar(255) [null]
  ip_address varchar(64) [null]
  expires_at timestamp [not null]
  revoked_at timestamp [null]
  created_at timestamp [not null, default: `now()`]
}

Table markets {
  id integer [pk, increment]
  code varchar(2) [not null, unique, note: 'UA or PL']
  name varchar(100) [not null]
  default_currency Currency [not null]
  default_locale varchar(10) [not null]
  is_active boolean [not null, default: true]
  tax_rate decimal(5,2) [not null, default: 0]
}

Table exchange_rates {
  id integer [pk, increment]
  base_currency Currency [not null]
  currency_code Currency [not null]
  rate decimal(12,6) [not null]
  effective_date date [not null]
  source varchar(50) [not null, note: 'NBU, NBP, or manual']

  indexes {
    (base_currency, currency_code, effective_date) [unique]
  }
}

Table shipping_methods {
  id integer [pk, increment]
  market_id integer [not null, ref: > markets.id]
  provider DeliveryProvider [not null]
  name varchar(100) [not null]
  cost decimal(12,2) [not null]
  currency Currency [not null]
  free_from_amount decimal(12,2) [null]
  delivery_days_min integer [null]
  delivery_days_max integer [null]
  is_active boolean [not null, default: true]
}

Table user_addresses {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  market_id integer [not null, ref: > markets.id]
  recipient_name varchar(200) [not null, note: 'same width as orders.recipient_name so checkout can copy without truncation']
  recipient_phone varchar(32) [not null, note: 'E.164 plus formatting; same width as orders.recipient_phone']
  delivery_provider DeliveryProvider [not null]
  provider_point_id varchar(64) [null]
  country_code varchar(2) [not null]
  is_default boolean [not null, default: false]
  city varchar(100) [null]
  postal_code varchar(16) [null]
  line1 varchar(255) [null]
  created_at timestamp [not null, default: `now()`]
}

Table categories {
  id integer [pk, increment]
  parent_id integer [null, ref: > categories.id]
  slug varchar(120) [not null, unique]
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]
}

Table category_translations {
  id bigint [pk, increment]
  category_id integer [not null, ref: > categories.id]
  locale varchar(10) [not null, note: 'uk and pl required, en optional']
  name varchar(150) [not null]
  description text [null]

  indexes {
    (category_id, locale) [unique]
  }
}

Table products {
  id bigint [pk, increment]
  category_id integer [not null, ref: > categories.id]
  slug varchar(160) [not null, unique]
  is_featured boolean [not null, default: false]
  published_at timestamp [null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table product_translations {
  id bigint [pk, increment]
  product_id bigint [not null, ref: > products.id]
  locale varchar(10) [not null, note: 'uk and pl required, en optional']
  name varchar(255) [not null]
  description text [null]
  meta_title varchar(255) [null]
  meta_description varchar(320) [null]

  indexes {
    (product_id, locale) [unique]
  }
}

Table product_variants {
  id bigint [pk, increment]
  product_id bigint [not null, ref: > products.id]
  sku varchar(64) [not null, unique]
  size varchar(64) [null]
  length_mm integer [null]
  weight decimal(8,3) [null, note: 'grams; depends on size/length_mm, affects price']
  metal_type MetalType [null]
  metal_color MetalColor [null]
  fineness integer [null, note: '375, 500, 585, 750, 875, 925, 958, 999']
  base_price decimal(12,2) [not null, note: 'analytics only; sale price is variant_prices']
  stock_quantity integer [not null, default: 0]
  reserved_quantity integer [not null, default: 0]
}

Table variant_prices {
  id bigint [pk, increment]
  variant_id bigint [not null, ref: > product_variants.id]
  currency Currency [not null]
  price decimal(12,2) [not null]
  sale_price decimal(12,2) [null]
  sale_starts_at timestamp [null]
  sale_ends_at timestamp [null]
  is_active boolean [not null, default: true]

  indexes {
    (variant_id, currency) [unique]
  }
}

Table product_images {
  id bigint [pk, increment]
  product_id bigint [not null, ref: > products.id]
  variant_id bigint [null, ref: > product_variants.id, note: 'set when the photo is specific to a metal color/variant']
  storage_key varchar(255) [not null]
  alt_text varchar(255) [null]
  is_primary boolean [not null, default: false]
  sort_order integer [not null, default: 0]
}

Table gemstones {
  id integer [pk, increment]
  slug varchar(50) [not null, unique, note: 'i18n key for uk/pl translation, e.g. diamond, sapphire, emerald']
  name varchar(100) [not null]
  kind varchar(50) [null]
}

Table product_gemstones {
  id bigint [pk, increment]
  product_id bigint [not null, ref: > products.id]
  variant_id bigint [null, ref: > product_variants.id, note: 'set when stone count/carat differs per size, e.g. a pave band']
  gemstone_id integer [not null, ref: > gemstones.id]
  gemstone_type GemstoneType [not null, default: 'Natural']
  quantity integer [not null, default: 1]
  carat decimal(6,3) [null]
  cut_type varchar(30) [null, note: 'Round, Princess, Cushion, Emerald, Pear, Oval, Marquise, ...']
  color_grade varchar(10) [null, note: 'diamond color D-Z, or a colored-stone grade']
  clarity_grade varchar(10) [null, note: 'FL, IF, VVS1, VVS2, VS1, VS2, SI1, SI2, I1-I3']
  setting_type varchar(30) [null, note: 'Prong, Bezel, Pave, Channel, Halo, ...']
  certificate_number varchar(64) [null, note: 'GIA / HRD / IGI report number']
  is_center_stone boolean [not null, default: false]
}

Table product_embeddings {
  product_id bigint [not null, ref: > products.id]
  locale varchar(10) [not null]
  model_name varchar(100) [not null, note: 'intfloat/multilingual-e5-small']
  embedding_version integer [not null, default: 1]
  content_hash varchar(64) [not null, note: 'hash of the source text; skip recompute when unchanged']
  embedding "vector(384)" [not null]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (product_id, locale, model_name) [pk]
  }
}

Table carts {
  id bigint [pk, increment]
  user_id bigint [null, ref: > users.id]
  session_token varchar(128) [null, unique]
  market_id integer [not null, ref: > markets.id]
  status CartStatus [not null, default: 'Active']
  last_activity_at timestamp [null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table cart_items {
  id bigint [pk, increment]
  cart_id bigint [not null, ref: > carts.id]
  variant_id bigint [not null, ref: > product_variants.id]
  quantity integer [not null]
  unit_price_at_add decimal(12,2) [null]

  indexes {
    (cart_id, variant_id) [unique]
  }
}

Table orders {
  id bigint [pk, increment]
  order_number varchar(32) [not null, unique, note: 'e.g. TNDC-2026-00145; shown to the customer instead of id']
  user_id bigint [null, ref: > users.id]
  market_id integer [not null, ref: > markets.id]
  shipping_method_id integer [null, ref: > shipping_methods.id]
  status OrderStatus [not null, default: 'Pending']
  currency Currency [not null]
  subtotal decimal(12,2) [not null]
  discount_amount decimal(12,2) [not null, default: 0]
  shipping_amount decimal(12,2) [not null, default: 0]
  total decimal(12,2) [not null]
  exchange_rate_used decimal(12,6) [null]
  locale varchar(10) [null]
  session_token varchar(128) [null]

  recipient_name varchar(200) [not null, note: 'snapshot at checkout; independent of later profile/address edits']
  recipient_phone varchar(32) [not null]
  customer_email varchar(255) [null, note: 'needed for guest orders where user_id is null']
  shipping_country varchar(2) [not null]
  shipping_city varchar(100) [null]
  shipping_address_line varchar(255) [null]
  provider_point_id varchar(64) [null, note: 'Nova Poshta branch / Paczkomat id, snapshot from user_addresses']
  tracking_number varchar(64) [null]
  customer_note text [null]

  created_at timestamp [not null, default: `now()`]
  paid_at timestamp [null]
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.id]
  product_id bigint [not null, ref: > products.id]
  variant_id bigint [null, ref: > product_variants.id]
  sku varchar(64) [not null]
  quantity integer [not null]
  unit_price decimal(12,2) [not null]
  product_name varchar(255) [not null, note: 'snapshot at purchase']
  variant_snapshot jsonb [null, note: 'size, metal, weight, gemstones at purchase; survives later variant edits or deletion']
}

Table payments {
  id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.id]
  provider PaymentProvider [not null]
  status PaymentStatus [not null, default: 'Pending']
  amount decimal(12,2) [not null]
  currency Currency [not null]
  external_id varchar(128) [null]
  idempotency_key varchar(128) [not null, unique, note: 'prevents double-charging on retried checkout requests']
  gateway_response jsonb [null, note: 'raw webhook payload for audit; never put card data here']
  created_at timestamp [not null, default: `now()`]
  paid_at timestamp [null]
  Note: 'Do not store card numbers or CVV'
}

Table favorites {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  product_id bigint [not null, ref: > products.id]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, product_id) [unique]
  }
}

Table price_history {
  id bigint [pk, increment]
  variant_id bigint [not null, ref: > product_variants.id]
  currency Currency [not null]
  price decimal(12,2) [not null]
  recorded_at timestamp [not null, default: `now()`]

  indexes {
    (variant_id, currency, recorded_at)
  }

  Note: 'Source for the EU Omnibus directive: PL market must disclose the lowest price shown in the last 30 days before a sale'
}

Enum Role {
  User
  Manager
  Admin
}

Enum UserStatus {
  PendingVerification
  Active
  Suspended
  Deactivated
}

Enum Currency {
  UAH
  PLN
}

Enum MetalType {
  Gold
  Silver
  Platinum
}

Enum MetalColor {
  White
  Yellow
  Rose
  Bicolor
}

Enum GemstoneType {
  Natural
  LabGrown
}

Enum CartStatus {
  Active
  Abandoned
  Converted
}

Enum OrderStatus {
  Pending
  Paid
  Processing
  Shipped
  Delivered
  Cancelled
  Returned
}

Enum PaymentStatus {
  Pending
  Succeeded
  Failed
  Refunded
}

Enum PaymentProvider {
  LiqPay
  Monobank
  Stripe
  Przelewy24
  PayU
  BLIK
}

Enum DeliveryProvider {
  NovaPoshta
  UkrPoshta
  InPost
  Paczkomaty
  DPD
  Courier
}
