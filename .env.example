POSTGRES_DB=tndc
POSTGRES_USER=tndc
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://tndc:<password>@localhost:5432/tndc
MEDIA_BASE_URL=http://localhost:8000/media
VITE_API_URL=http://localhost:8000

JWT_SECRET=random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:5173"]
PASSWORD_PEPPER=random-64-char-string

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SERVER_URL=http://localhost:8000/payments/webhook/liqpay
LIQPAY_SANDBOX=true

PENDING_ORDER_TTL_MINUTES=30
EVENT_RETENTION_DAYS=365
APP_ENV=dev
# Recommendations (M6) — defaults live in Settings, override here to experiment
RECO_WEIGHT_BEHAVIOR=0.4
RECO_WEIGHT_CONTENT=0.3
RECO_WEIGHT_POPULARITY=0.2
RECO_WEIGHT_NOVELTY=0.1
RECO_DECAY_LAMBDA=0.1
RECO_HISTORY_DAYS=90
RECO_POPULARITY_SHORT_DAYS=7
RECO_POPULARITY_LONG_DAYS=30
RECO_LIMIT=12
RECO_MAX_PER_CATEGORY=4

# Search (M7)
EMBEDDER_URL=http://localhost:8001
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_VERSION=1
SEMANTIC_SEARCH_ENABLED=true
SIMILAR_SOURCE=cbf
SEARCH_RRF_K=60

SIMILAR_SOURCE=cbf
RECO_CACHE_TTL_SECONDS=600